                "exec": [
                  "\r\npm.test(\"EVH-50: Responde HTTP 400 Bad Request\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"EVH-50: Devuelve VALIDATION_ERROR\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(JSON.stringify(response)).to.include(\r\n        \"VALIDATION_ERROR\"\r\n    );\r\n});\r\n\r\npm.test(\"EVH-50: Devuelve un mensaje de error\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(JSON.stringify(response).toLowerCase())\r\n        .to.include(\"email\");\r\n});\r\n\r\npm.test(\"EVH-50: Devuelve una respuesta JSON\", function () {\r\n    const contentType = pm.response.headers.get(\"Content-Type\");\r\n\r\n    pm.expect(contentType).to.include(\"application/json\");\r\n});\r\n"
