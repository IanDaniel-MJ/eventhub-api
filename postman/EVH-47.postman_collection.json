          "name": "PUT - Actualizar ponente existente (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"EVH-50: Responde HTTP 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"EVH-50: Conserva el ID original\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.id).to.eql(\r\n        \"a1b2c3d4-1111-4000-8000-000000000001\"\r\n    );\r\n});\r\n\r\npm.test(\"EVH-50: Actualiza correctamente los cuatro campos\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.nombre).to.eql(\"Elena Martinez Actualizada\");\r\n    pm.expect(response.email).to.eql(\"elena.actualizada@ipn.mx\");\r\n    pm.expect(response.institucion).to.eql(\"UPIITA\");\r\n    pm.expect(response.especialidad).to.eql(\"Robotica\");\r\n});\r\n\r\n\r\npm.test(\"EVH-50: Devuelve una respuesta JSON\", function () {\r\n    const contentType = pm.response.headers.get(\"Content-Type\");\r\n\r\n    pm.expect(contentType).to.include(\"application/json\");\r\n});\r\n\r\n"
                ]
              }
            }
          ],
